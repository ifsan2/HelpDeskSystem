@page
@model HelpDesk.Web.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Sign In";
}

<style>
    .login-wrapper {
        min-height: 85vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 35px 15px;
        background: #f4f6f9;
    }

    .login-card {
        width: 100%;
        max-width: 440px;
        background: #ffffff;
        border: none;
        border-radius: 16px;
        box-shadow: 0 10px 35px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }

    .login-header {
        background: #263b55;
        color: white;
        padding: 32px;
        text-align: center;
    }

        .login-header .brand-icon {
            font-size: 34px;
            margin-bottom: 12px;
        }

        .login-header h2 {
            font-size: 25px;
            font-weight: 700;
            margin-bottom: 7px;
        }

        .login-header p {
            margin: 0;
            color: #d5deea;
            font-size: 14px;
        }

    .login-body {
        padding: 32px;
    }

    .form-label {
        font-weight: 600;
        font-size: 14px;
        color: #344054;
    }

    .form-control {
        height: 46px;
        border-radius: 8px;
        border: 1px solid #d0d5dd;
        padding: 10px 13px;
    }

        .form-control:focus {
            border-color: #456b96;
            box-shadow: 0 0 0 3px rgba(69, 107, 150, 0.12);
        }

    .password-wrapper {
        position: relative;
    }

        .password-wrapper .form-control {
            padding-right: 48px;
        }

    .password-toggle {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        border: none;
        background: transparent;
        color: #667085;
        cursor: pointer;
    }

    .login-btn {
        height: 47px;
        border-radius: 8px;
        background: #263b55;
        border: none;
        color: white;
        font-weight: 600;
        transition: background 0.2s ease;
    }

        .login-btn:hover {
            background: #344f70;
            color: white;
        }

    .login-footer {
        text-align: center;
        margin-top: 24px;
        font-size: 14px;
    }

        .login-footer a {
            color: #315d89;
            font-weight: 600;
            text-decoration: none;
        }

            .login-footer a:hover {
                text-decoration: underline;
            }

    @@media (max-width: 480px) {
        .login-body {
            padding: 25px 22px;
        }

        .login-header {
            padding: 27px 20px;
        }
    }
</style>

<div class="login-wrapper">
    <div class="login-card">

        <div class="login-header">
            <div class="brand-icon">
                <i class="bi bi-headset"></i>
            </div>

            <h2>Welcome Back</h2>
            <p>Sign in to access your HelpDesk account</p>
        </div>

        <div class="login-body">

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    <i class="bi bi-exclamation-circle me-2"></i>
                    @Model.ErrorMessage
                </div>
            }

            <form method="post" id="loginForm">

                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label" for="Email">
                        Email Address
                    </label>

                    <input type="email"
                           id="Email"
                           name="Email"
                           class="form-control"
                           placeholder="Enter your email"
                           autocomplete="username"
                           required />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="Password">
                        Password
                    </label>

                    <div class="password-wrapper">
                        <input type="password"
                               id="Password"
                               name="Password"
                               class="form-control"
                               placeholder="Enter your password"
                               autocomplete="current-password"
                               required />

                        <button type="button"
                                class="password-toggle"
                                id="togglePassword"
                                aria-label="Show password">
                            <i class="bi bi-eye" id="passwordIcon"></i>
                        </button>
                    </div>
                </div>

                <button type="submit"
                        class="btn login-btn w-100"
                        id="loginButton">

                    <span id="buttonText">
                        <i class="bi bi-box-arrow-in-right me-2"></i>
                        Sign In
                    </span>

                    <span id="loadingText" style="display:none;">
                        <span class="spinner-border spinner-border-sm me-2"
                              aria-hidden="true"></span>
                        Signing in...
                    </span>
                </button>

            </form>

            <div class="login-footer">
                Don't have an account?
                <a href="/register">Create an employee account</a>
            </div>

        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const passwordInput = document.getElementById("Password");
        const toggleButton = document.getElementById("togglePassword");
        const passwordIcon = document.getElementById("passwordIcon");
        const loginForm = document.getElementById("loginForm");
        const loginButton = document.getElementById("loginButton");

        toggleButton.addEventListener("click", function () {

            const isPassword = passwordInput.type === "password";

            passwordInput.type = isPassword ? "text" : "password";

            passwordIcon.className = isPassword
                ? "bi bi-eye-slash"
                : "bi bi-eye";

            toggleButton.setAttribute(
                "aria-label",
                isPassword ? "Hide password" : "Show password"
            );
        });

        loginForm.addEventListener("submit", function (event) {

            if (!loginForm.checkValidity()) {
                return;
            }

            loginButton.disabled = true;

            document.getElementById("buttonText").style.display = "none";
            document.getElementById("loadingText").style.display = "inline";
        });

    });
</script>
