@page "/employee/my-tickets"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Employee")]

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using HelpDesk.BLL.DTOs.Tickets
@using HelpDesk.BLL.Interfaces.Services

@inject ITicketService TicketService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>My Support Tickets</PageTitle>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>My Support Tickets</h2>
            <p class="text-muted">
                View and track your submitted support requests.
            </p>
        </div>

        <a href="/employee/create-ticket"
           class="btn btn-primary">
            Create New Ticket
        </a>
    </div>

    @if (isLoading)
    {
        <p>Loading your tickets...</p>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }
    else if (tickets.Count == 0)
    {
        <div class="alert alert-info">
            You haven't submitted any support tickets yet.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Ticket Number</th>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Assigned Technician</th>
                            <th>Created</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var ticket in tickets)
                        {
                            <tr>
                                <td>
                                    <a href="@($"/employee/ticket/{ticket.Id}")"
                                       class="text-decoration-none fw-semibold">
                                        @ticket.TicketNumber
                                    </a>
                                </td>

                                <td>@ticket.Title</td>

                                <td>@ticket.CategoryName</td>

                                <td>
                                    <span class="badge bg-secondary">
                                        @ticket.Priority
                                    </span>
                                </td>

                                <td>
                                    @if (ticket.Status == "Open")
                                    {
                                        <span class="badge bg-primary">
                                            Open
                                        </span>
                                    }
                                    else if (ticket.Status == "In Progress")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            In Progress
                                        </span>
                                    }
                                    else if (ticket.Status == "Resolved")
                                    {
                                        <span class="badge bg-success">
                                            Resolved
                                        </span>
                                    }
                                    else if (ticket.Status == "Closed")
                                    {
                                        <span class="badge bg-dark">
                                            Closed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @ticket.Status
                                        </span>
                                    }
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(ticket.AssignedTechnicianName)
                                        ? "Not assigned"
                                        : ticket.AssignedTechnicianName)
                                </td>

                                <td>
                                    @ticket.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>

        <p class="text-muted mt-3">
            Total tickets: @tickets.Count
        </p>
    }

</div>

@code {
    private List<EmployeeTicketDto> tickets = new();

    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authenticationState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();

            var user = authenticationState.User;

            var employeeId = user.FindFirst(
                ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrWhiteSpace(employeeId))
            {
                errorMessage = "Unable to identify your employee account.";
                return;
            }

            var result = await TicketService.GetMyTicketsAsync(employeeId);

            tickets = result.ToList();
        }
        catch (Exception)
        {
            errorMessage = "Unable to load your support tickets.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
