@page "/technician/dashboard"

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Technician")]

<PageTitle>Technician Dashboard</PageTitle>

<div class="container mt-4">

    <h2>Technician Dashboard</h2>

    <p class="text-muted">
        Welcome to the IT Support Technician Panel.
    </p>

    <div class="row g-3 mt-3">

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <h5>Assigned Tickets</h5>

                    <p class="text-muted">
                        View and manage tickets assigned to you.
                    </p>

                    <div class="mt-auto">
                        <a href="/technician/assigned-tickets"
                           class="btn btn-primary">
                            View Assigned Tickets
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <h5>Available Tickets</h5>

                    <p class="text-muted">
                        Review tickets waiting for assignment.
                    </p>

                    <div class="mt-auto">
                        <a href="/technician/available-tickets"
                           class="btn btn-primary">
                            View Available Tickets
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <h5>Ticket Conversations</h5>

                    <p class="text-muted">
                        Communicate with employees about their issues.
                    </p>

                    <div class="mt-auto">
                        <a href="/technician/conversations"
                           class="btn btn-primary">
                            View Conversations
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>
